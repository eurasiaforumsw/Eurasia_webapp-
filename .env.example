# Vercel Blob Storage (for avatar uploads)
BLOB_READ_WRITE_TOKEN=

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://efsw.org

# Demo Admin Credentials (change in production)
# Email: admin@efsw.local
ADMIN_DEMO_PASSWORD=

# Security
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Reader-facing translation (MyMemory)
# Optional. The provider works without a key; supplying a contact email raises
# the anonymous daily character limit from 5k to 50k.
MYMEMORY_CONTACT_EMAIL=

