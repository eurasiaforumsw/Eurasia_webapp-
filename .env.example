# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Vercel (optional - usually auto-injected)
VERCEL_URL="localhost:2024"
NEXT_PUBLIC_VERCEL_URL="http://localhost:2024"

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:2024

# Admin Authentication
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters required for security
JWT_SECRET=your-jwt-secret-minimum-32-characters

# Generate password hash with: node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('YOUR_PASSWORD', 12).then(console.log);"
# This replaces NEXT_PUBLIC_ADMIN_PASSWORD for server-side validation
# Default credentials for development:
#   Email: admin@efsw.local
#   Password: EFSW-secure-admin-2024
ADMIN_PASSWORD_HASH=$2b$12$wHZkOiIcpUAq7DbR8LQkWefbHqNx6YTUfwEpBCKdWYOGALNn50Gnm

# Email Service (Resend) - Required for email verification
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com