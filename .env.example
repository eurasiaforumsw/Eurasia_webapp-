# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Vercel (optional - usually auto-injected)
VERCEL_URL="localhost:2024"
NEXT_PUBLIC_VERCEL_URL="http://localhost:2024"

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:2024

# Admin Authentication
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters required for security
JWT_SECRET=

# Generate a .env-ready password hash with: node scripts/generate-admin-hash.js
# Escape every $ as \$ in .env files so Next.js preserves the bcrypt hash.
# Hosting environment dashboards use the raw bcrypt hash without these backslashes.
# This replaces NEXT_PUBLIC_ADMIN_PASSWORD for server-side validation
# Generate your own hash; shared demo passwords are rejected in production.
ADMIN_PASSWORD_HASH=

# Production defaults to database; apply migration 022 before deployment.
# memory is for local development or a single process, and resets on restart.
SECURITY_RATE_LIMIT_STORE=database
# Enable only behind a proxy that overwrites X-Forwarded-For and blocks direct access.
SECURITY_TRUST_PROXY=false

# Email Service (Resend) - Required for email verification
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com
